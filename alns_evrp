def build_instances_dict(instance_names, instances_dir):
    instances = {}
    for name in instance_names:
        filepath = None
        for ext in ['.evrp', '.txt', '.vrp', '']:
            cand = os.path.join(instances_dir, f"{name}{ext}")
            if os.path.exists(cand):
                filepath = cand; break
        if filepath is None:
            print(f"⚠️ Fichier introuvable : {name}")
            continue
        with open(filepath, 'r', encoding='utf-8') as f:
            instances[name] = (f.read(), PUBLISHED_BKS.get(name))
        print(f"✅ Chargée : {name} (BKS = {PUBLISHED_BKS.get(name)})")
    return instances
